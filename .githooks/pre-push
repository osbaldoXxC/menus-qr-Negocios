#!/bin/sh
# Hook de seguridad local: Impide push directo a la rama main
# MexxicanMX / menus-qr-Negocios

protected_branch="main"
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/$protected_branch" ]; then
        echo ""
        echo "=========================================================================="
        echo " 🛑 [ACCESO BLOQUEADO POR REGLA DE SEGURIDAD]"
        echo " Está estrictamente prohibido hacer push directo a la rama '$protected_branch'."
        echo " Flujo permitido:"
        echo "   1. Trabaja y haz push en la rama 'develop' o en ramas 'feature/*'."
        echo "   2. Crea un Pull Request hacia 'main' para revisión y aprobación."
        echo "=========================================================================="
        echo ""
        exit 1
    fi
done

exit 0
