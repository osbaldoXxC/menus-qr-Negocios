# ============================================
# MexxicanMX - Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores

# ===== BASE DE DATOS =====
DATABASE_URL=postgresql://admin:password123@localhost:5432/mexxicanmx_db

# ===== REDIS =====
REDIS_URL=redis://localhost:6379

# ===== JWT =====
JWT_SECRET=cambia_esto_por_un_secreto_seguro
REFRESH_TOKEN_SECRET=cambia_esto_por_otro_secreto_seguro

# ===== FRONTEND =====
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000/api

# ===== AWS S3 =====
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=mexxicanmx-media
CLOUDFRONT_DOMAIN=https://d123456.cloudfront.net

# ===== AI ENGINE =====
AI_ENGINE_URL=http://ai-engine:8000

# ===== URLS PÚBLICAS =====
PUBLIC_MENU_URL=https://mexxican.mx/menu/

# ===== ENTORNO =====
NODE_ENV=development
PORT=4000