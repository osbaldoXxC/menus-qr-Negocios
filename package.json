{
  "name": "menus-qr-negocios",
  "version": "1.0.0",
  "main": "download_images.js",
  "scripts": {
    "test": "npm run test:schema",
    "test:schema": "python scripts/validate_code_vs_schema.py --schema db/contract/schema.json --root .",
    "test:cfn": "python test_cloudformation.py",
    "db:extract-schema": "python scripts/extract_schema.py --out db/contract",
    "db:generate-contract": "node scripts/generate_contract.js",
    "preflight": "python scripts/preflight_deploy.py",
    "deploy": "python deploy.py",
    "dev:comensales": "npm --prefix frontend-comensales run dev",
    "dev:restaurantes": "npm --prefix frontend-restaurantes run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:comensales": "npm --prefix frontend-comensales run build",
    "build:restaurantes": "npm --prefix frontend-restaurantes run build",
    "build:admin": "npm --prefix admin run build",
    "build:all": "npm run build:comensales && npm run build:restaurantes && npm run build:admin",
    "docker:up": "docker compose -f compose.yml up -d",
    "docker:down": "docker compose -f compose.yml down",
    "docker:logs": "docker compose -f compose.yml logs -f"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.62.0"
  },
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
